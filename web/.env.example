# phloid.com / Weather Wars web app environment
# Copy to .env.local for local development. Keep real values out of git.

# Required in production for Vercel cron endpoints.
# Vercel Cron should send: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Weather provider API keys used by scraper parsers.
OPENWEATHER_API_KEY=
WEATHERAPI_API_KEY=

# Postgres connection string consumed by the existing Vercel data layer and opportunity core.
POSTGRES_URL=

# Phase 2A protected opportunity portal. Keep both values in the provider secret store.
# Use at least 32 random bytes for the session secret; rotating it invalidates existing sessions.
OPPORTUNITY_SESSION_SECRET=
# Encoded PBKDF2 value produced by createPasswordHash(); never store the plaintext password here.
OPPORTUNITY_PORTAL_PASSWORD_HASH=
# Non-secret client binding for this deployment.
OPPORTUNITY_CLIENT_SLUG=mike-rapp

# Phase 2B Craigslist saved-search intake. Production is restricted to Fastmail TLS/993.
# Store credentials only in the provider secret store; never commit real values.
OPPORTUNITY_IMAP_HOST=imap.fastmail.com
OPPORTUNITY_IMAP_PORT=993
OPPORTUNITY_IMAP_USER=
OPPORTUNITY_IMAP_PASSWORD=
OPPORTUNITY_INTAKE_ADDRESS=babs@phloid.com
